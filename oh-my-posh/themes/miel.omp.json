{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "root",
          "style": "plain",
          "foreground": "#A66A2C",
          "template": "root <#FFF1CC>in</> "
        },
        {
          "type": "path",
          "style": "plain",
          "foreground": "#E6A817",
          "template": "{{ $folders := splitList \"/\" .Location }}{{ $lastFullFolder := sub (len $folders) 2 }}{{ range $index, $folder := $folders }}{{ if ne $folder \"\" }}/{{ if lt $index $lastFullFolder }}{{ if hasPrefix \".\" $folder }}{{ substr 0 2 $folder }}{{ else }}{{ substr 0 1 $folder }}{{ end }}{{ else }}{{ $folder }}{{ end }}{{ end }}{{ end }} ",
          "options": {
            "style": "full"
          }
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "#FFC857",
          "template": "<#FFF1CC>on</> {{ if .IsWorkTree }}󰉍 {{ end }}{{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Rebase }} 󰑓{{ end }}{{ if .Merge }} 󰘬{{ end }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }} \uf046 {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }}  {{ .StashCount }}{{ end }} ",
          "options": {
            "branch_icon": " ",
            "fetch_status": true
          }
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "light-gradient(#d70000)",
          "template": "{{ cmd \"sh\" \"-c\" \"miel-versions 0\" }}"
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "light-gradient(#ff5f00)",
          "template": "{{ cmd \"sh\" \"-c\" \"miel-versions 1\" }}"
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "light-gradient(#ffaf00)",
          "template": "{{ cmd \"sh\" \"-c\" \"miel-versions 2\" }}"
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "light-gradient(#e5a717)",
          "template": "{{ cmd \"sh\" \"-c\" \"miel-versions 3\" }}"
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "light-gradient(#d70000)",
          "template": "{{ cmd \"sh\" \"-c\" \"miel-versions 4\" }}"
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "light-gradient(#ff5f00)",
          "template": "{{ cmd \"sh\" \"-c\" \"miel-versions 5\" }}"
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "light-gradient(#ffaf00)",
          "template": "{{ cmd \"sh\" \"-c\" \"miel-versions 6\" }}"
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "light-gradient(#e5a717)",
          "template": "{{ cmd \"sh\" \"-c\" \"miel-versions 7\" }}"
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "light-gradient(#d70000)",
          "template": "{{ cmd \"sh\" \"-c\" \"miel-versions 8\" }}"
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "light-gradient(#ff5f00)",
          "template": "{{ cmd \"sh\" \"-c\" \"miel-versions 9\" }}"
        },

        {
          "type": "status",
          "style": "plain",
          "foreground": "#A66A2C",
          "template": "⁠ x "
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "#FFC857",
          "template": "λ "
        }
      ]
    }
  ]
}
